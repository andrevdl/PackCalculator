<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PackCalculator</PackageId>
    <Authors>André van der Laan</Authors>
    <Description>Model and visualize C / TwinCAT-style struct memory layout — compute size, alignment, and padding from composable primitives, arrays, strings, and nested objects.</Description>
    <PackageTags>memory-layout;struct;alignment;padding;twincat;plc;interop;data-structures</PackageTags>
    <PackageProjectUrl>https://github.com/andrevdl/PackCalculator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/andrevdl/PackCalculator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Version is derived from Git tags by MinVer (e.g. tag "v1.2.3" => 1.2.3). -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EditorConfigFiles Remove="C:\Users\andre\source\repos\PackCalculator\PackCalculator\.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <None Include="C:\Users\andre\source\repos\PackCalculator\PackCalculator\.editorconfig" />
  </ItemGroup>

</Project>
